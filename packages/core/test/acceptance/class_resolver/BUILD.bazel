load("//tools:defaults.bzl", "ts_project", "zoneless_jasmine_test")

package(default_visibility = ["//visibility:private"])

ts_project(
    name = "off_subtree_cases",
    testonly = True,
    srcs = ["off_subtree_cases.ts"],
    deps = [
        "//packages/core",
        "//packages/core/testing",
    ],
)

ts_project(
    name = "class_resolver_lib",
    testonly = True,
    srcs = glob(
        ["**/*.ts"],
        exclude = [
            "auto_resolution_spec.ts",
            "off_subtree_cases.ts",
        ],
    ),
    deps = [
        ":off_subtree_cases",
        "//packages/core",
        "//packages/core/testing",
    ],
)

zoneless_jasmine_test(
    name = "class_resolver",
    data = [
        ":class_resolver_lib",
    ],
)

# Automatic resolution turns its runtime on for the whole process, so its specs run in their own
# target, apart from the specs above that must run without it.
ts_project(
    name = "auto_resolution_lib",
    testonly = True,
    srcs = ["auto_resolution_spec.ts"],
    deps = [
        ":off_subtree_cases",
        "//packages/common",
        "//packages/core",
        "//packages/core/testing",
        "//packages/router",
    ],
)

zoneless_jasmine_test(
    name = "auto_resolution",
    data = [
        ":auto_resolution_lib",
    ],
)
